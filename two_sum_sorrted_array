#include <iostream>
using namespace std;

int array_sum(int a[], int size, int target) {
    cout << "Size: " << size << endl;
    
    size=size-1;
    int i=0;
      while(i<size)
     {
         std::cout<<a[i]<<a[size]<<"\n";
         if(a[i]+a[size] == target)
         {
             std::cout<<a[i]<<a[size]<<std::endl;
             std::cout<<"pattern found";
             break;
         }
         if(a[i]+a[size] < target)
         {
            i++;
         }
         if(a[i]+a[size] > target)
         {
            size--;
         }
     }
    
    return 0;
}

int main() {
    int test[5] = {1, 3, 5, 7, 9};
    int size = sizeof(test) / sizeof(test[0]);  // calculate in main
    int target = 8;
    
    array_sum(test, size, target);
    return 0;
}
